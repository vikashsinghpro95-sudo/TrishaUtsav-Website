<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block sensitive dotfiles
    <FilesMatch "^(composer\.(json|lock)|\.env(\.\w+)?|\.git|README|LICENSE|package\.json|check_dummy\.php)$">
        Require all denied
    </FilesMatch>

    # 1. Route API requests to the bridge script
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ api.php [QSA,L]

    # 2. Redirect direct .php requests to clean URLs
    RewriteCond %{THE_REQUEST} \s/+(public/)?index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+(public/)?([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L]

    # 3. Allow direct access to existing static files (css, js, images)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Map clean path to matching PHP file (e.g. /shop -> shop.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)$ $1.php [QSA,L]

    # 5. Fallback missing routes to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
