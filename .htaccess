<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block ALL metadata/dotfiles at the web root
    <FilesMatch "^(composer\.(json|lock)|\.env(\.\w+)?|\.git|README|LICENSE|package\.json|check_dummy\.php)$">
        Require all denied
    </FilesMatch>

    # ----------------------------------------------------------------------
    # 1. PRESERVE API ENDPOINTS & SERVE PUBLIC ASSETS / UPLOADS
    # ----------------------------------------------------------------------
    # Route /api/... requests to root index.php
    RewriteRule ^api(/.*)?$ index.php [QSA,L]

    # Map /assets/... -> public/assets/... if file/dir exists in public/assets/
    RewriteCond %{DOCUMENT_ROOT}/public/assets/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/assets/$1 -d
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Map /uploads/... -> public/uploads/... if file/dir exists in public/uploads/
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -d
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # ----------------------------------------------------------------------
    # 2. 301 PERMANENT REDIRECTS FOR DIRECT .php REQUESTS TO CLEAN URLs
    # ----------------------------------------------------------------------
    # Redirect /index.php or /public/index.php -> /
    RewriteCond %{THE_REQUEST} \s/+(public/)?index\.php[\s?] [NC]
    RewriteRule ^(public/)?index\.php$ / [R=301,L]

    # Redirect /admin/page.php -> /admin/page
    RewriteCond %{THE_REQUEST} \s/+admin/([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^admin/(.+)\.php$ /admin/$1 [R=301,L]

    # Redirect /public/page.php or /page.php -> /page
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^public/(.+)\.php$ /$1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteRule ^(.+)\.php$ /$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 3. INTERNAL REWRITES FOR CLEAN EXTENSIONLESS URLs
    # ----------------------------------------------------------------------
    # Root URL / -> serve public/index.php
    RewriteRule ^$ public/index.php [L]

    # Allow direct access to existing physical files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Admin section clean URLs: e.g. /admin/login -> admin/login.php
    RewriteCond %{DOCUMENT_ROOT}/admin/$1.php -f
    RewriteRule ^admin/(.+)$ admin/$1.php [QSA,L]

    # Public storefront clean URLs: e.g. /about -> public/about.php
    RewriteCond %{DOCUMENT_ROOT}/public/$1.php -f
    RewriteRule ^([^/]+)$ public/$1.php [QSA,L]

    # Fallback missing routes in public storefront to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
