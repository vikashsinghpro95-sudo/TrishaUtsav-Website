# Deny direct execution of scripts inside the uploads directory to prevent remote code execution
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|jsp|sh|cgi|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
